vars: {
  d2-config: {
    theme-id: 200
  }
}

direction: right

title: "Fleet — Orchestration: the Router relays every hand-off (Executor / Operator / Supervisor never talk directly)" {
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

# ---------------- planning side ----------------
sc: "SC\nproduct owner · decides" {
  style.fill: "#2A1B3A"; style.stroke: "#A569BD"; style.font-color: "#F3EAFB"
}

planner: "Planner\nstands missions up" {
  style.fill: "#14352A"; style.stroke: "#2ECC71"; style.font-color: "#E8F8F0"
}

# ---------------- the handler holds the mission ----------------
handler: "Handler  ·  holds one mission" {
  style.fill: "#2B2810"; style.stroke: "#F1C40F"; style.font-color: "#FBF6E3"
  ra: "Requirements\nAnalyst" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
  scribe: "Scribe" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
  executor: "Executor\nruns the mission" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
  router: "Router\nrelay / transport" { style.fill: "#4A3A0E"; style.stroke: "#F7DC6F"; style.bold: true }

  ra -> scribe: "agreement" { style.stroke: "#F1C40F" }
  scribe -> executor: "mission" { style.stroke: "#F1C40F" }
}

# ---------------- the per-phase workers (external actors) ----------------
operator: "Operator\none role per phase\n(Maker OR Apostle OR Scout …)\noperators never talk to each other" {
  style.fill: "#2E1E0E"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3"
}

supervisor: "Supervisor\nthird-party check" {
  style.fill: "#3A1714"; style.stroke: "#E74C3C"; style.font-color: "#FBEAEA"
}

# ---------------- planning edges ----------------
sc -> planner: "plan / sequence work" { style.stroke: "#A569BD"; style.stroke-width: 3 }
planner -> handler: "stands up" { style.stroke: "#2ECC71"; style.stroke-width: 3 }
sc -> handler.ra: "direction" { style.stroke: "#A569BD"; style.stroke-width: 3 }
handler.executor -> sc: "report (a decision)" { style.stroke: "#A569BD"; style.stroke-width: 3 }

# ---------------- the phase loop — EVERY hop goes through the Router ----------------
handler.executor -> handler.router: "① hand off phase" { style.stroke: "#F7DC6F"; style.stroke-width: 2 }
handler.router -> operator: "② dispatch phase" { style.stroke: "#E67E22"; style.stroke-width: 3 }
operator -> handler.router: "③ output (code / plan + brief)" { style.stroke: "#E67E22"; style.stroke-width: 3 }
handler.router -> supervisor: "④ for review" { style.stroke: "#E74C3C"; style.stroke-width: 3 }
supervisor -> handler.router: "⑤ verdict" { style.stroke: "#E74C3C"; style.stroke-width: 3 }
handler.router -> handler.executor: "⑥ verdict → Executor decides" { style.stroke: "#F7DC6F"; style.stroke-width: 2 }

note: "One phase = the loop ①→⑥, and the Router is the only thing that touches the Operator and the Supervisor.\nThe Executor never talks to the Operator or Supervisor directly, and the Operator and Supervisor never talk to each other.\nThink OSI: Executor / Operator / Supervisor are peers; the Router is the layer beneath that carries every message.\nMulti-phase missions just repeat the loop — phase 2's operator works from phase 1's committed output, never from phase 1's operator. One operator per phase, always." {
  near: bottom-center
  shape: text
  style.font-color: "#7F8C8D"
}
