vars: {
  d2-config: {
    theme-id: 200
  }
}

direction: right

title: "Fleet — Role → Skill map (handler/planner granular; operators by group; foundational load for all)" {
  near: top-center
  shape: text
  style.font-size: 18
  style.bold: true
}

# ================= HANDLER FAMILY + PLANNER (granular) =================

handler: "Handler (actor)" {
  style.fill: "#2B2810"; style.stroke: "#F1C40F"; style.font-color: "#FBF6E3"
  interlocutor: "Interlocutor" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
  squad_selector: "Squad-selector" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
  scribe: "Scribe" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
  executor: "Executor" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
  router: "Router" { style.fill: "#3A3413"; style.stroke: "#F1C40F" }
}
planner: "Planner (actor)" {
  style.fill: "#14352A"; style.stroke: "#2ECC71"; style.font-color: "#E8F8F0"
  scheduler: "Scheduler" { style.fill: "#1C4433"; style.stroke: "#2ECC71" }
  launcher: "Launcher" { style.fill: "#1C4433"; style.stroke: "#2ECC71" }
  coach: "Coach" { style.fill: "#1C4433"; style.stroke: "#2ECC71" }
}
supervisor: "Supervisor (actor)" { style.fill: "#3A1714"; style.stroke: "#E74C3C"; style.font-color: "#FBEAEA" }

hskills: "Handler / Planner skills (individual)" {
  style.fill: transparent; style.stroke: "#444A5A"; style.stroke-dash: 4; style.font-color: "#7F8C8D"
  active_listening: "active-listening" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  squad_selection: "squad-selection" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  mission_grounding: "mission-grounding" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  mission_artefacts: "mission-artefacts" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  sc_ghostwriting: "sc-ghostwriting" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  prompt_authoring: "prompt-authoring" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  dispatch: "dispatch" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  testament: "testament" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  worktrees: "worktrees" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  project_memory: "project-memory" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  issue_writing: "issue-writing" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  post_mortem: "post-mortem" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  standing_up: "standing-up-handlers" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  mission_boards: "mission-boards" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
  drive_pm: "drive-post-mortem" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2" }
}

handler.interlocutor -> hskills.active_listening
handler.interlocutor -> hskills.sc_ghostwriting
handler.interlocutor -> hskills.mission_artefacts
handler.squad_selector -> hskills.squad_selection
handler.squad_selector -> hskills.mission_artefacts
handler.scribe -> hskills.prompt_authoring
handler.scribe -> hskills.mission_grounding
handler.scribe -> hskills.mission_artefacts
handler.router -> hskills.dispatch
handler.executor -> hskills.worktrees
handler.executor -> hskills.post_mortem
handler.executor -> hskills.mission_artefacts
handler -> hskills.testament
handler -> hskills.project_memory
handler -> hskills.issue_writing
planner.scheduler -> hskills.mission_boards
planner.launcher -> hskills.standing_up
planner.coach -> hskills.drive_pm
supervisor -> hskills.testament

# ================= OPERATORS (by group) =================

operator: "Operator (actor)" {
  style.fill: "#2E1E0E"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3"
  codecommit: "maker · builder · scaffolder ·\napprentice · cleaner" { style.fill: "#3A2412"; style.stroke: "#E67E22" }
  apostle: "apostle" { style.fill: "#3A2412"; style.stroke: "#E67E22" }
  design: "architect · engineer" { style.fill: "#3A2412"; style.stroke: "#E67E22" }
  reviewer: "reviewer" { style.fill: "#3A2412"; style.stroke: "#E67E22" }
  discovery: "scout · investigator" { style.fill: "#3A2412"; style.stroke: "#E67E22" }
  writer: "writer" { style.fill: "#3A2412"; style.stroke: "#E67E22" }
  courier: "courier" { style.fill: "#3A2412"; style.stroke: "#E67E22" }
}

g_code: "typescript-standards\ntdd\ntech-debt" { style.fill: "#26201A"; style.stroke: "#E67E22"; style.font-color: "#FBEFE3" }
g_write: "technical-writing\nsc-commit-writing\nsc-ghostwriting" { style.fill: "#2A2438"; style.stroke: "#A569BD"; style.font-color: "#F3EAFB" }
g_git: "git-knowledge\ngit-workflow\npre-commit · git-cleanup" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2"; style.font-color: "#EAF2FB" }
g_review: "devops-review\nazure-devops-pr-review" { style.fill: "#2B1E1E"; style.stroke: "#E74C3C"; style.font-color: "#FBEAEA" }
g_delivery: "github-pr / azure-devops-pr\n(+ azure-devops, ado-work-items,\nazure-devops-boards)" { style.fill: "#1E2B2B"; style.stroke: "#5DADE2"; style.font-color: "#EAF2FB" }

operator.codecommit -> g_code
operator.codecommit -> g_write
operator.apostle -> g_code
operator.apostle -> g_write
operator.design -> g_code
operator.reviewer -> g_code
operator.reviewer -> g_review
operator.reviewer -> g_git
operator.discovery -> g_git
operator.writer -> g_write
operator.courier -> g_write
operator.courier -> g_git
operator.courier -> g_delivery

# ================= UNUSED (no role yet) =================

unused: "Not loaded by default — pulled in when the work calls for it\n(e.g. application-cve for a maintenance release)" {
  style.fill: "#1A1A22"; style.stroke: "#566573"; style.font-color: "#AEB6BF"
  c: "conventions: detect-convention,\nshellicar/-oss/-config, eagers/-branding,\nflightrac, hopeventures, typescript-standards*" { style.fill: "#15151C"; style.stroke: "#566573" }
  w: "work-items: backlog-management,\nwork-item-hygiene/-migration, work-organisation" { style.fill: "#15151C"; style.stroke: "#566573" }
  s: "security: application-cve, auto-approve-security,\nsecret-remediation, secret-scanning" { style.fill: "#15151C"; style.stroke: "#566573" }
  m: "skill-meta: skill-hygiene/-management/\n-philosophy/-repair" { style.fill: "#15151C"; style.stroke: "#566573" }
  r: "release: maintenance-release, -fleet" { style.fill: "#15151C"; style.stroke: "#566573" }
  t: "mcp/tools: mcp-context7, mcp-shellicar,\ncli-tools, deferred-tools, shell-scripting" { style.fill: "#15151C"; style.stroke: "#566573" }
  d: "delivery extras: github-release/milestone/\nversion/repos, azure-devops-config/\n-pipelines/-repos" { style.fill: "#15151C"; style.stroke: "#566573" }
}

note: "Foundational (claude-philosophy, commander-protocol, teapot-protocol, specification-discipline, transparency, executive-communication, clear-communication, safe-operations, co-working) load for every cast — not shown.\nHandler/planner are granular (each individual skill); operators map to skill groups (they're handed the skills, so group granularity is enough). The bottom box is skills not loaded by default — pulled in when a specific kind of work calls for them (not unused, and not a fleet/non-fleet split).\n*typescript-standards sits in code-craft for operators; the project-specific conventions skills next to it are on-demand, not default-loaded." {
  near: bottom-center
  shape: text
  style.font-color: "#7F8C8D"
}
